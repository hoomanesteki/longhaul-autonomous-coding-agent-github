+++ b/src/textkit/case.py
@@ -0,0 +1,8 @@
+import re
+
+_WORD_EDGE = re.compile(r"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])")
+
+
+def camel_to_snake(text: str) -> str:
+    """Turn camelCase or PascalCase into snake_case. Text that is already snake_case is kept."""
+    return _WORD_EDGE.sub("_", text).lower()
