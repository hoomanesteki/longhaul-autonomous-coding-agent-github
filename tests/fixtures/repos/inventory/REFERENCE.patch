@@ -0,0 +1,11 @@
+import pytest
+
+from inventory import Inventory, InventoryError
+
+
+def test_remove_too_much_raises_inventory_error_and_keeps_stock() -> None:
+    inv = Inventory()
+    inv.add("widget", 1)
+    with pytest.raises(InventoryError):
+        inv.remove("widget", 2)
+    assert inv.quantity("widget") == 1
