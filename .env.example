# Local defaults for the docker compose stack. Copy to .env. Secrets stay blank.
# A blank value counts as unset. Variables already set in the shell win over this file.
LONGHAUL_DATABASE_URL=postgresql://longhaul:longhaul@localhost:5432/longhaul
LONGHAUL_TEMPORAL_ADDRESS=localhost:7233
LONGHAUL_TEMPORAL_NAMESPACE=default
LONGHAUL_TASK_QUEUE=longhaul
LONGHAUL_BLOB_ENDPOINT=http://localhost:9000
LONGHAUL_BLOB_BUCKET=longhaul
LONGHAUL_BLOB_ACCESS_KEY=longhaul
LONGHAUL_BLOB_SECRET_KEY=longhaul-secret
# anthropic | openai | scripted | replay
LONGHAUL_PROVIDER=scripted
# Script for the scripted provider, for example tests/fixtures/scripts/calc_fix.yaml
LONGHAUL_SCRIPT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LONGHAUL_GITHUB_TOKEN=
LONGHAUL_GITHUB_APP_ID=
LONGHAUL_GITHUB_APP_KEY_PATH=
LONGHAUL_ADMIN_TOKEN=
LONGHAUL_CONFIG=config/longhaul.example.yaml
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Host ports for the compose stack. Change these if another project holds the defaults.
LH_POSTGRES_PORT=5432
LH_TEMPORAL_PORT=7233
LH_TEMPORAL_UI_PORT=8233
LH_MINIO_PORT=9000
LH_JAEGER_UI_PORT=16686
LH_OTLP_GRPC_PORT=4317
LH_OTLP_HTTP_PORT=4318
LH_PROMETHEUS_PORT=9090
LH_GRAFANA_PORT=3000
