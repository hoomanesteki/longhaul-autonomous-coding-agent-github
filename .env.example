# Local defaults for the docker compose stack. Copy to .env. Secrets stay blank.
# A blank value counts as unset. Variables already set in the shell win over this file.
LONGHAUL_DATABASE_URL=postgresql://longhaul:longhaul@localhost:5432/longhaul
LONGHAUL_TEMPORAL_ADDRESS=localhost:7233
LONGHAUL_TEMPORAL_NAMESPACE=default
LONGHAUL_TASK_QUEUE=longhaul
LONGHAUL_BLOB_ENDPOINT=http://localhost:9000
LONGHAUL_BLOB_BUCKET=longhaul
LONGHAUL_BLOB_ACCESS_KEY=longhaul
LONGHAUL_BLOB_SECRET_KEY=longhaul-secret
# anthropic | openai | scripted | replay
LONGHAUL_PROVIDER=scripted
# Script for the scripted provider, for example tests/fixtures/scripts/calc_fix.yaml
LONGHAUL_SCRIPT=
# Recorded model calls. LONGHAUL_PROVIDER=replay plays the folder. LONGHAUL_RECORD=1 saves every
# call of the provider into it. See "Record and replay model calls" in docs/runbook.md.
LONGHAUL_RECORDINGS_DIR=
LONGHAUL_RECORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LONGHAUL_GITHUB_TOKEN=
LONGHAUL_GITHUB_APP_ID=
LONGHAUL_GITHUB_APP_KEY_PATH=
# Where GitHub is. Blank means api.github.com and github.com. A GitHub Enterprise server sets the
# API address (https://host/api/v3) and the web address (https://host). Clones and pushes go to
# <web address>/<owner>/<name>.git.
LONGHAUL_GITHUB_API_URL=
LONGHAUL_GITHUB_WEB_URL=
LONGHAUL_ADMIN_TOKEN=
LONGHAUL_CONFIG=config/longhaul.example.yaml
# Where the worker keeps one bare git repo per task (ADR-0006). Blank means ~/.longhaul/ckpt.
# The folder is created private (0700). Docker mounts the repos from here into the sandboxes.
LONGHAUL_CKPT_DIR=
# Author and committer of the commits on a pull request branch, as "Name <address>". Blank means
# longhaul <longhaul@users.noreply.github.com>.
LONGHAUL_GIT_AUTHOR=
# Folder of the Jinja templates, such as the pull request body. Blank means templates/ here.
LONGHAUL_TEMPLATES_DIR=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Postgres superuser password for the compose stack. The database reads it once, when the data
# volume is first created, so change it before the first make up, or run make down first.
# Keep the password inside LONGHAUL_DATABASE_URL above in step with it.
LH_POSTGRES_PASSWORD=longhaul

# Checkpoint folder of the worker in docker compose (profile full). It is mounted into the worker
# at the same path, so use an absolute path that exists on the host. Blank means /var/lib/longhaul/ckpt.
# A worker started with `longhaul worker` uses LONGHAUL_CKPT_DIR above instead.
LH_CKPT_DIR=

# Host ports for the compose stack. Every port is published on 127.0.0.1 only.
# Change these if another project holds the defaults.
LH_POSTGRES_PORT=5432
LH_TEMPORAL_PORT=7233
LH_TEMPORAL_UI_PORT=8233
LH_MINIO_PORT=9000
LH_JAEGER_UI_PORT=16686
LH_OTLP_GRPC_PORT=4317
LH_OTLP_HTTP_PORT=4318
LH_PROMETHEUS_PORT=9090
LH_GRAFANA_PORT=3000
